# ==============================================================================
# Vandebron Configuration
# ==============================================================================
# OIDC refresh token extracted from mijn.vandebron.nl browser storage (LocalStorage)
VANDEBRON_REFRESH_TOKEN=your_vandebron_refresh_token_here

# Numeric consumer ID (from profile / API URL)
VANDEBRON_CONSUMER_ID=2796694

# UUID consumer identifier (from profile / API URL)
VANDEBRON_CONSUMER_UUID=603f0fae-2ea8-4488-9da4-b49b00962663

# Gas and Electricity connection UUIDs
VANDEBRON_GAS_CONNECTION_ID=377f6a24-cb7d-49ae-819b-b49b00965afa
VANDEBRON_ELECTRICITY_CONNECTION_ID=5ef3885d-6583-40fd-8e22-b49b00965add

# ==============================================================================
# Home Assistant Configuration
# ==============================================================================
# WebSocket API URL (e.g. ws://homeassistant.local/api/websocket or ws://192.168.178.16/api/websocket)
HOMEASSISTANT_WS_URL=ws://homeassistant.local/api/websocket

# Home Assistant Long-Lived Access Token
HOMEASSISTANT_ACCESS_TOKEN=your_home_assistant_long_lived_access_token_here

# Target statistic IDs in Home Assistant Energy Dashboard
HOMEASSISTANT_GAS_STATISTIC_ID=sensor.vandebron_gas_consumption
HOMEASSISTANT_ELECTRICITY_STATISTIC_ID=sensor.vandebron_electricity_consumption

# ==============================================================================
# Daemon / Scheduling Configuration (Optional)
# ==============================================================================
# Set DAEMON_MODE=true for continuous daily background execution (e.g. in Docker)
DAEMON_MODE=false
SYNC_TIME=08:30
TZ=Europe/Amsterdam
